# Copy this file to .env and fill in your real values. Never commit .env.

# Your Dynatrace environment's OTLP endpoint, e.g.:
# https://abc12345.live.dynatrace.com/api/v2/otlp
DT_OTLP_ENDPOINT=https://YOUR_ENVIRONMENT_ID.live.dynatrace.com/api/v2/otlp

# API token generated in Dynatrace under Access Tokens, with scopes:
#   openTelemetryTrace.ingest, metrics.ingest, logs.ingest
DT_API_TOKEN=dt0c01.XXXXXXXXXXXXXXXXXXXXXXXX
